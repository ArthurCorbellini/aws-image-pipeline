{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "S3ImagePipelineAccess",
      "Effect": "Allow",
      "Action": [
        "s3:PutObject",
        "s3:GetObject"
      ],
      "Resource": "arn:aws:s3:::image-pipeline-s3-5dafe7b0/*"
    },
    {
      "Sid": "SqsImagePipelineAccess",
      "Effect": "Allow",
      "Action": [
        "sqs:SendMessage",
        "sqs:ReceiveMessage",
        "sqs:DeleteMessage"
      ],
      "Resource": "arn:aws:sqs:us-east-1:<ACCOUNT_ID>:image-pipeline-sqs"
    }
  ]
}
